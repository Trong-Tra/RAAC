# RAAC — copy to app/.env.local and fill secrets. Never commit .env.local.
# One network only: Base Sepolia 84532. All Hedera/HCS/x402 keys are deprecated.

# ── Database (pick ONE) ──
# Local (this device) — use with `docker compose up -d` (orbstack) or brew postgres:
#   compose.yaml runs raac-pg on 5433 (postgres:raac/raac, DB raac)
#   DATABASE_URL=postgresql://postgres:raac@localhost:5433/raac?sslmode=disable
# Partner Neon (remote) — keep if you share the partner DB:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://postgres:raac@localhost:5433/raac?sslmode=disable

# ── Base Sepolia 84532 (single network) ──
# Public RPC is enough for reads; no private key needed until Phase 6 anchoring.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Phase 6 anchoring wallet — funded on 84532, server-side only. Do NOT set until deployment ping.
# BASE_SEPOLIA_PRIVATE_KEY=0xSECRET_64_HEX
# Optional fee override for demo paper (wei, 0.001 ETH = 1000000000000000):
# REVIEW_FEE_WEI=1000000000000000

# ── The Graph (pick ONE to enable live ranking) ──
# Either engages Base Sepolia Agent0/ERC-8004 reputation (live). Both unset = deterministic mock fallback.
THEGRAPH_API_KEY=
AGENT0_SUBGRAPH_URL=

# ── Optional (leave unset unless needed) ──
# LANGSMITH_API_KEY= # tracing for selector/council, needs LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=raac-demo
# LANGSMITH_TRACING=true
# OPENROUTER_API_KEY= # only if you wire LLM reviews in council
# CHAT_MODEL=openai/gpt-4o-mini
# GITHUB_TOKEN= # not used by RAAC (legacy)
