# Copy to app/.env.local and fill in secrets. Never commit .env.local.
# Public / non-secret values are safe to share; anything marked SECRET is not.

# Required: online PostgreSQL (Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Base Sepolia — single network for RAAC (ERC-8004).
# No Hedera. Review fee settlement is on Base Sepolia.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional: private key for contract interactions (keep secret, server-side only).
# REVIEW_FEE_WEI=0

# Optional integrations.
# The Graph: free API key (thegraph.com Studio). Reads PUBLIC Agent0/ERC-8004
# indexes (reputation lives on Base — Hedera has no ERC-8004 contracts); deploys
# nothing. Either this or AGENT0_SUBGRAPH_URL engages live trust context.
THEGRAPH_API_KEY=
AGENT0_SUBGRAPH_URL=
GITHUB_TOKEN=
LEDGER_PROVIDER=dev
LEDGER_WALLET_CLI_PATH=
LLM_INTENT_PROVIDER=
# Chat intent parser (plan-16 demo surface only — never authorization):
# OpenRouter pinned; any model id works, default is small/fast/cheap.
# Unset = templates-only chat, free-text box honestly disabled.
OPENROUTER_API_KEY=
CHAT_MODEL=openai/gpt-4o-mini
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=raac-demo
# REQUIRED for trace links (key alone is not enough — the SDK defaults tracing
# OFF and getCurrentRunTree() returns an id-less stub without it).
LANGSMITH_TRACING=true
